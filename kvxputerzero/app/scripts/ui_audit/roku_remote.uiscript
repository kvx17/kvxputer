# Roku remote UI: picker, remote face, keyboard banner, help, themes
wait 200
theme dark
wait 120
open roku
wait 2800
shot roku_picker_dark
key right
wait 40
key enter
wait 200
shot roku_enter_ip
# Prefill already has last IP when set; connect without retyping.
key enter
wait 600
shot roku_remote_dark
key h
wait 120
shot roku_help_dark
key esc
wait 80
key esc
wait 200
shot roku_keyboard_banner
wait 900
shot roku_keyboard_mode
type abc
wait 100
shot roku_typing
key esc
wait 200
shot roku_back_remote
key d
wait 200
shot roku_picker_again
theme light
wait 120
open roku
wait 2800
shot roku_picker_light
key right
wait 40
key enter
wait 100
key enter
wait 600
shot roku_remote_light
key h
wait 120
shot roku_help_light
key esc
wait 60
key esc
wait 200
shot roku_keyboard_light
quit
