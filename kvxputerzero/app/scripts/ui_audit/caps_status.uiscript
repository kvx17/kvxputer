# Cap status / info / probe — missing-hardware states on emulator
wait 200
open rf_status
wait 300
shot rf_status
theme light
wait 120
shot rf_status_light
theme dark
wait 80
key esc
wait 80

open nrf24_info
wait 250
shot nrf24_info
key esc
wait 80
open nrf24_status
wait 300
shot nrf24_status
key esc
wait 80

open fm_info
wait 250
shot fm_info
key esc
wait 80
open fm_status
wait 300
shot fm_status
key esc
wait 80

open lora_status
wait 300
shot lora_status
key esc
wait 80
open lora_mesh
wait 250
shot lora_mesh
key esc
wait 80

open rfid_status
wait 300
shot rfid_status
key esc
wait 80
open nfc_status
wait 300
shot nfc_status
key esc
wait 80

open cap_probe
wait 500
shot cap_probe
key esc
wait 80
open unit_scroll
wait 250
shot unit_scroll
key esc
wait 80
quit
