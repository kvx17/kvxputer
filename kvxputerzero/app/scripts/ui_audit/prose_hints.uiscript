# Prose / make_info / make_results offenders outside PC Connect
wait 200
open wifi_ap_info
wait 250
shot wifi_ap_info
key esc
wait 80

open ssh_hint
wait 200
shot ssh_hint
key esc
wait 80

open ble_disconnect
wait 200
shot ble_disconnect
key esc
wait 80

open mqtt
wait 200
shot mqtt_menu_or_help
# try open help if it's a menu — esc anyway
key esc
wait 80

open ibutton
wait 200
shot ibutton_hint
key esc
wait 80

open files_share_hint
wait 200
shot files_share_hint
key esc
wait 80

open bus_scan
wait 300
shot bus_scan
key esc
wait 80

# WireGuard often has help results
open wireguard
wait 250
shot wireguard
key esc
wait 80
quit
