# File Share: QR + credentials, Space toggles password, Esc reopens cleanly
wait 200
theme dark
wait 100
open file_share
wait 400
shot files_share_hint
key space
wait 100
shot files_share_pwd_visible
key space
wait 80
key esc
wait 200
open files_share_hint
wait 400
shot files_share_reopen
theme light
wait 150
open file_share
wait 400
shot files_share_light
key esc
wait 80
quit
