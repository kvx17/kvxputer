# PDA deep stages + Passgen/TOTP (Tools leftovers that feel like apps)
wait 200
theme dark
wait 100

page pda
wait 180
shot apps2_pda_hub

# Notes list → new note prompt if empty
key enter
wait 180
shot apps2_notes_list
key enter
wait 200
shot apps2_notes_edit_or_empty
key esc
wait 80
key esc
wait 80

# Memos
page pda_memos
wait 180
shot apps2_memos
key esc
wait 60

# Todo
page pda_todo
wait 180
shot apps2_todo
key esc
wait 60

# Contacts
page pda_contacts
wait 180
shot apps2_contacts
key esc
wait 60

# Alarms
page pda_alarms
wait 180
shot apps2_alarms
key esc
wait 60

# Calendar + day
page pda_calendar
wait 220
shot apps2_calendar
key enter
wait 200
shot apps2_calendar_day
key esc
wait 60
key esc
wait 60

page pda_world
wait 220
shot apps2_world_clock
key esc
wait 60

# Passgen / TOTP
page passgen
wait 200
shot apps2_passgen
key esc
wait 60
page totp
wait 200
shot apps2_totp_menu
key esc
wait 60

# Media + Files again with light
theme light
wait 120
open media_player
wait 220
shot apps2_media_light
open files_browser
wait 220
shot apps2_files_light
open ir_use
wait 220
shot apps2_ir_use_light
theme dark
wait 60
quit
